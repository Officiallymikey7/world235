body {
  margin: 0;
  background-color: #0f172a;
  color: #f8fafc;
  font-family: system-ui, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

#app-container {
  text-align: center;
}

canvas {
  border: 2px solid #38bdf8;
  border-radius: 8px;
  background-color: #1e293b;
  box-shadow: 0 10px 25px rgba(0,0,0,0.5);
}
